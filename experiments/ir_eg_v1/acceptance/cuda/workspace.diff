+                status='PREPARED_NOT_LAUNCHED',budget_kind='budget_audit',epochs=200,
+                accepted_main_steps=44400,scientific_convergence_claim=False,
+                expected_source=dict(receivers=[1,3,4,6,8],days=[1,2,3],L=6300,U=56700,V=27000),
