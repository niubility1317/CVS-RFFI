+@dataclass(frozen=True)
+class ParamLayout:
+    names: tuple[str, ...]
+    shapes: tuple[torch.Size, ...]
+    phi_indices: tuple[int, ...]
+    psi_indices: tuple[int, ...]
+    aliases: dict[str, str]
+    signature: str
+
+@dataclass(frozen=True)
+class DomainCall:
+    key: str
