+    origin,record,h,layout=args;v=record['optimizer_after']['state'][0]['exp_avg_sq']/(1-.8)
+    f=lambda x: -.03*(.3*.25*x)/(.3*(v.sqrt()+1e-5))
+    fd=(f(h[0]+step)-f(h[0]-step))/(2*step)
