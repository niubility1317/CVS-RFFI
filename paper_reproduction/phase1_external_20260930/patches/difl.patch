+def _matched_iq_and_labels(data_path, label_path, dev_range):
+    # Select labels and corresponding physical rows together. Original load_labels
+    # grouped labels by TX but did not apply that permutation to the signal rows.
+    loader = LoadDataset()
+    data = loader.load_stft_data(data_path)
+    raw = np.asarray(np.load(label_path)).reshape(-1)
+    if not np.isfinite(raw).all() or not np.equal(raw, np.floor(raw)).all():
+        raise ValueError("Labels must be finite integers")
+    labels = raw.astype(int) - 1  # original author input is 1-based
+    if len(data) != len(labels):
+        raise ValueError(f"IQ/label length mismatch: {len(data)} != {len(labels)}")
+    if data.ndim != 3 or data.shape[1:] != (2, 256) or not np.isfinite(data).all():
+        raise ValueError("Expected finite author-format IQ [N,256,2], yielding [N,2,256]")
+    mask = np.isin(labels, dev_range)
+    if not mask.any():
+        raise ValueError("No samples in selected TX range")
+    return data[mask], labels[mask]
+
